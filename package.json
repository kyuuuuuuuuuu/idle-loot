{
  "name": "idle-loot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "竖屏横版放置刷宝小游戏原型（Phaser 4 + TypeScript）",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "sim": "node scripts/sim.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  }
}
